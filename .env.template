# Ask RGV AI — Environment Variables
# cp .env.template .env  →  fill all CHANGE_ME values  →  docker compose up -d
#
# Generate secrets with: openssl rand -hex 32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
ASKRGV_POSTGRES_PASSWORD=CHANGE_ME

# ── Auth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME          # Google Cloud Console → OAuth 2.0 → Web + Android client
JWT_SECRET=CHANGE_ME                # openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME          # openssl rand -hex 32  (separate from user JWT)
ADMIN_PASSWORD=CHANGE_ME            # plain password for POST /admin/auth/login
ADMIN_DASHBOARD_EMAIL=CHANGE_ME     # only this email may call POST /admin/auth/login (with password)
ADMIN_IP_ALLOWLIST=CHANGE_ME        # comma-separated IPs allowed to hit /admin/* e.g. 1.2.3.4

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── Deepgram (STT) ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=CHANGE_ME

# ── Smallest.ai (TTS) ────────────────────────────────────────────────────────
SMALLEST_AI_API_KEY=CHANGE_ME
SMALLEST_AI_VOICE_EN=CHANGE_ME        # English voice clone ID
SMALLEST_AI_VOICE_TE=CHANGE_ME        # Telugu voice clone ID
SMALLEST_AI_VOICE_HI=CHANGE_ME        # Hindi voice clone ID

# ── Firebase FCM ─────────────────────────────────────────────────────────────
# Mount the JSON file into the container, or bake it into the image at build time
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
WORKERS=4

# ── Internal service URLs (set automatically by docker-compose — do not change) ─
# DATABASE_URL       = postgresql://askrgv:...@postgres:5432/askrgv
# QDRANT_URL         = http://qdrant:6333
# QDRANT_COLLECTION  = rgv_knowledge
# EMBEDDING_SERVICE_URL = http://bge-m3:8001
# INGESTION_WORKER_URL  = http://ingestion:8002
# REDIS_URL          = redis://redis:6379/0
