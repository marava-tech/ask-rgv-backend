# Ask RGV AI — Environment Variables
# cp .env.template .env  →  fill all CHANGE_ME values  →  docker compose up -d
#
# Generate secrets with: openssl rand -hex 32

# ── PostgreSQL ────────────────────────────────────────────────────────────────
ASKRGV_POSTGRES_PASSWORD=CHANGE_ME

# ── Auth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME          # Google Cloud Console → OAuth 2.0 → Web + Android client
JWT_SECRET=CHANGE_ME                # openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME          # openssl rand -hex 32  (separate from user JWT)
ADMIN_PASSWORD=                      # legacy — leave empty when TOTP is configured
ADMIN_TOTP_SECRET=CHANGE_ME         # base32 TOTP secret for Google Authenticator
ADMIN_DASHBOARD_EMAIL=CHANGE_ME     # only this email may call POST /admin/auth/login
ADMIN_IP_ALLOWLIST=CHANGE_ME        # comma-separated IPs allowed to hit /admin/* e.g. 1.2.3.4

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME

# ── Google Play IAP ───────────────────────────────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=tech.marava.askrgv
GOOGLE_SERVICE_ACCOUNT_JSON=/app/google-service-account.json  # mount the JSON key file

# ── Deepgram (STT) ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=CHANGE_ME

# ── Smallest.ai (TTS) ────────────────────────────────────────────────────────
SMALLEST_AI_API_KEY=CHANGE_ME
VOICE_ID_EN=CHANGE_ME                 # Smallest.ai English voice clone ID
VOICE_ID_TE=CHANGE_ME                 # Smallest.ai Telugu voice clone ID
VOICE_ID_HI=CHANGE_ME                 # Smallest.ai Hindi voice clone ID

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_DATA_API_KEY=CHANGE_ME      # Used for video title fetch + caption detection (no IP blocking)

# ── Firebase FCM ─────────────────────────────────────────────────────────────
# Mount the JSON file into the container, or bake it into the image at build time
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# ── Email (waitlist confirmation) ────────────────────────────────────────────
EMAIL_ENABLED=false                  # set to true in production
EMAIL_FROM=CHANGE_ME                 # sender address
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=CHANGE_ME             # Gmail address
EMAIL_PASSWORD=CHANGE_ME             # Gmail App Password (not account password)

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
WORKERS=4

# ── Internal service URLs (set automatically by docker-compose — do not change) ─
# DATABASE_URL       = postgresql://askrgv:...@postgres:5432/askrgv
# QDRANT_URL         = http://qdrant:6333
# QDRANT_COLLECTION  = rgv_knowledge
# EMBEDDING_SERVICE_URL = http://bge-m3:8001
# INGESTION_WORKER_URL  = http://ingestion:8002
# REDIS_URL          = redis://redis:6379/0
